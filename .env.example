# ==========================================
# ITSM Automation Platform Configuration
# ==========================================

# App & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=itsm-automation-secret-key-change-in-prod
API_PORT=8000

# Mock ITSM Database
DATABASE_URL=sqlite:///./data/itsm.db

# Webhook Security
WEBHOOK_SECRET=itsm_webhook_signing_secret_key_12345

# LLM & AI Triage Configuration
# Provider options: mock, openai, anthropic, gemini
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
AI_CONFIDENCE_THRESHOLD=0.80

# Notifications (Optional Slack/Teams Webhooks)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Microsoft Graph / SharePoint Integration
# Set to 'local' for local offline file & list store, or 'graph' for Microsoft 365
DOCUMENTATION_PROVIDER=local
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_LIST_NAME=ITSM Operational Improvement Tracker
SHAREPOINT_DOC_LIBRARY=ITSM Process Reports

# Automation Engine Settings
SLA_CHECK_INTERVAL_SECONDS=30
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2
